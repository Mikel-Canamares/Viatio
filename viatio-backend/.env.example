# ==========================================
# VIATIO BACKEND - Environment Variables
# ==========================================

# -----------------------------------------
# SERVER
# -----------------------------------------
# Puerto del servidor (Railway usa su propio puerto en producción)
PORT=3000

# Entorno de ejecución
# Valores: development | production
NODE_ENV=development

# -----------------------------------------
# GOOGLE GEMINI AI
# -----------------------------------------
# API Key de Google Gemini (obtén una en https://ai.google.dev)
# CRÍTICO: Esta key es necesaria para OCR y asistente de viaje
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------
# CORS - Cross-Origin Resource Sharing
# -----------------------------------------
# Orígenes permitidos (separados por comas, sin espacios)
#
# DESARROLLO LOCAL:
# - Actualiza la IP con tu IP local (usa ipconfig/ifconfig)
# - Expo usa exp:// para túneles de desarrollo
#
# PRODUCCIÓN:
# - Usa '*' temporalmente para pruebas
# - En producción final, especifica dominios exactos
#
# Ejemplos:
CORS_ORIGINS=http://localhost:8081,exp://192.168.0.16:8081,http://192.168.0.16:8081

# Para producción (Railway):
# CORS_ORIGINS=*
# o especifica los dominios de tu app:
# CORS_ORIGINS=https://tu-app.expo.dev,exp://tu-app.exp.host
