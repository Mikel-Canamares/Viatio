# Puerto del servidor
PORT=3000

# API Key de Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Entorno (development | production)
NODE_ENV=development

# CORS - Orígenes permitidos (separados por comas)
# Actualiza la IP con tu IP local (usa ipconfig para obtenerla)
CORS_ORIGINS=http://localhost:8081,exp://192.168.0.16:8081,http://192.168.0.16:8081
