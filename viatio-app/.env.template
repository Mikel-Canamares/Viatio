# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Obtén estos valores desde Firebase Console > Project Settings
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# ============================================
# GOOGLE MAPS API
# ============================================
# Obtén la API key desde Google Cloud Console
# Asegúrate de habilitar: Maps SDK, Places API, Directions API
GOOGLE_MAPS_API_KEY=

# ============================================
# BACKEND - Viatio Backend API
# ============================================
# URL del backend Node.js para integración con Gemini AI
#
# DESARROLLO LOCAL:
# - Deja vacío para usar localhost:3000 por defecto
# - O especifica tu IP local si pruebas en dispositivo físico:
#   EXPO_PUBLIC_BACKEND_URL=http://192.168.0.16:3000
#
# PRODUCCIÓN (Railway):
# - Usa la URL pública que Railway te asigna:
#   EXPO_PUBLIC_BACKEND_URL=https://tu-proyecto.up.railway.app
#
# IMPORTANTE: Debe tener el prefijo EXPO_PUBLIC_ para que Expo lo inyecte
EXPO_PUBLIC_BACKEND_URL=
