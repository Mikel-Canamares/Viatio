# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Obtén estos valores desde Firebase Console > Project Settings
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# ============================================
# GOOGLE MAPS API
# ============================================
# Obtén la API key desde Google Cloud Console
# Asegúrate de habilitar: Maps SDK, Places API, Directions API
GOOGLE_MAPS_API_KEY=

# ============================================
# BACKEND (OPCIONAL)
# ============================================
# URL del backend Node.js para integración con Gemini
# Déjalo vacío si usarás el backend local en desarrollo
BACKEND_URL=
